# App
NODE_ENV=development
PORT=3001

# VM deployment (browser: http://172.29.153.63 — frontend mapped to host port 80)
CORS_ORIGIN=http://172.29.153.63
VITE_API_BASE_URL=http://172.29.153.63:3001/api/v1

# Local development (uncomment and comment VM lines above)
# CORS_ORIGIN=http://localhost:3000
# VITE_API_BASE_URL=http://localhost:3001/api/v1

# Database (used for local dev without Docker; Compose uses postgres service hostname)
DATABASE_URL=postgresql://oe_user:oe_password@localhost:5432/oe_tracker

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_another_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SharePoint (optional — leave blank to disable SP integration)
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_URL=
