generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  SALES
  PRESALES
  VIEWER
}

enum DocumentType {
  PROPOSAL
  QUOTATION
  CONTRACT
  SPECIFICATION
  NDA
  MEETING_MINUTES
  PURCHASE_ORDER
  INVOICE
  TECHNICAL_DOCUMENT
  CORRESPONDENCE
  OTHER
}

enum AccessAction {
  VIEW
  DOWNLOAD
  EDIT
  DELETE
}

model User {
  id                  String    @id @default(uuid())
  fullName            String    @map("full_name") @db.VarChar(150)
  email               String    @unique @db.VarChar(200)
  passwordHash        String    @map("password_hash")
  role                UserRole  @default(VIEWER)
  businessUnit        String?   @map("business_unit") @db.VarChar(50)
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  opportunitiesAsSales    Opportunity[]        @relation("SalesRelation")
  opportunitiesAsPresales Opportunity[]        @relation("PresalesRelation")
  opportunitiesCreated    Opportunity[]        @relation("CreatedByRelation")
  opportunitiesUpdated    Opportunity[]        @relation("UpdatedByRelation")
  historyEntries          OpportunityHistory[]
  documentsReceived       Document[]           @relation("ReceivedByRelation")
  documentsUploaded       Document[]           @relation("UploadedByRelation")
  accessLogs              DocumentAccessLog[]
  notifications           Notification[]
  auditLogs               AuditLog[]

  @@map("users")
}

model Customer {
  id            String        @id @default(uuid())
  name          String        @unique @db.VarChar(200)
  segment       String?       @db.VarChar(100)
  region        String?       @db.VarChar(100)
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  opportunities Opportunity[]
  documents     Document[]

  @@map("customers")
}

model ProductCategory {
  id            String               @id @default(uuid())
  name          String               @unique @db.VarChar(100)
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at")
  subcategories ProductSubcategory[]
  opportunities Opportunity[]

  @@map("product_categories")
}

model ProductSubcategory {
  id            String          @id @default(uuid())
  name          String          @db.VarChar(150)
  categoryId    String          @map("category_id")
  category      ProductCategory @relation(fields: [categoryId], references: [id])
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")
  opportunities Opportunity[]

  @@map("product_subcategories")
}

model BusinessCategory {
  id            String        @id @default(uuid())
  name          String        @unique @db.VarChar(100)
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  opportunities Opportunity[]

  @@map("business_categories")
}

model BusinessUnit {
  id            String        @id @default(uuid())
  name          String        @unique @db.VarChar(50)
  description   String?
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  opportunities Opportunity[]

  @@map("business_units")
}

model DealStage {
  id                 String        @id @default(uuid())
  code               String        @unique @db.VarChar(20)
  classification     String        @db.VarChar(100)
  status             String        @db.VarChar(100)
  winningProbability Decimal       @map("winning_probability") @db.Decimal(5, 2)
  sortOrder          Int           @map("sort_order")
  isActive           Boolean       @default(true) @map("is_active")
  opportunities      Opportunity[]

  @@map("deal_stages")
}

model ConfidenceLevel {
  id            String        @id @default(uuid())
  name          String        @unique @db.VarChar(50)
  sortOrder     Int           @map("sort_order")
  opportunities Opportunity[]

  @@map("confidence_levels")
}

model Opportunity {
  id                   String               @id @default(uuid())
  serialNumber         Int                  @unique @default(autoincrement()) @map("serial_number")
  customerId           String               @map("customer_id")
  customer             Customer             @relation(fields: [customerId], references: [id])
  description          String
  businessUnitId       String               @map("business_unit_id")
  businessUnit         BusinessUnit         @relation(fields: [businessUnitId], references: [id])
  productCategoryId    String               @map("product_category_id")
  productCategory      ProductCategory      @relation(fields: [productCategoryId], references: [id])
  productSubcategoryId String               @map("product_subcategory_id")
  productSubcategory   ProductSubcategory   @relation(fields: [productSubcategoryId], references: [id])
  businessCategoryId   String               @map("business_category_id")
  businessCategory     BusinessCategory     @relation(fields: [businessCategoryId], references: [id])
  pinSalesId           String               @map("pin_sales_id")
  pinSales             User                 @relation("SalesRelation", fields: [pinSalesId], references: [id])
  pinPresalesId        String?              @map("pin_presales_id")
  pinPresales          User?                @relation("PresalesRelation", fields: [pinPresalesId], references: [id])
  dealStageId          String               @map("deal_stage_id")
  dealStage            DealStage            @relation(fields: [dealStageId], references: [id])
  confidenceLevelId    String               @map("confidence_level_id")
  confidenceLevel      ConfidenceLevel      @relation(fields: [confidenceLevelId], references: [id])
  estimatedClosureDate DateTime?            @map("estimated_closure_date") @db.Date
  lifetimeVolume       BigInt               @map("lifetime_volume")
  unitPriceInr         Decimal              @map("unit_price_inr") @db.Decimal(14, 2)
  unitPriceUsd         Decimal              @map("unit_price_usd") @db.Decimal(14, 4)
  tcvUsdMillion        Decimal              @map("tcv_usd_million") @db.Decimal(12, 4)
  comments             String?
  pms                  String?              @db.VarChar(200)
  remarks              String?
  isActive             Boolean              @default(true) @map("is_active")
  createdById          String               @map("created_by")
  createdBy            User                 @relation("CreatedByRelation", fields: [createdById], references: [id])
  updatedById          String?              @map("updated_by")
  updatedBy            User?                @relation("UpdatedByRelation", fields: [updatedById], references: [id])
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  history              OpportunityHistory[]
  documents            Document[]

  @@map("opportunities")
}

model OpportunityHistory {
  id            String      @id @default(uuid())
  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  changedById   String      @map("changed_by")
  changedBy     User        @relation(fields: [changedById], references: [id])
  changedAt     DateTime    @default(now()) @map("changed_at")
  fieldName     String      @map("field_name") @db.VarChar(100)
  oldValue      String?     @map("old_value")
  newValue      String?     @map("new_value")
  changeNote    String?     @map("change_note")

  @@map("opportunity_history")
}

model Document {
  id                String              @id @default(uuid())
  title             String              @db.VarChar(300)
  documentType      DocumentType        @map("document_type")
  receivedDate      DateTime?           @map("received_date") @db.Date
  receivedById      String?             @map("received_by_id")
  receivedBy        User?               @relation("ReceivedByRelation", fields: [receivedById], references: [id])
  customerId        String?             @map("customer_id")
  customer          Customer?           @relation(fields: [customerId], references: [id])
  opportunityId     String?             @map("opportunity_id")
  opportunity       Opportunity?        @relation(fields: [opportunityId], references: [id])
  sharepointUrl     String              @map("sharepoint_url")
  sharepointFileId  String?             @map("sharepoint_file_id") @db.VarChar(500)
  sharepointLibrary String?             @map("sharepoint_library") @db.VarChar(300)
  fileName          String              @map("file_name") @db.VarChar(500)
  fileSizeKb        Int?                @map("file_size_kb")
  mimeType          String?             @map("mime_type") @db.VarChar(100)
  version           String?             @db.VarChar(50)
  description       String?
  tags              String[]
  isConfidential    Boolean             @default(false) @map("is_confidential")
  uploadedById      String              @map("uploaded_by")
  uploadedBy        User                @relation("UploadedByRelation", fields: [uploadedById], references: [id])
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  accessLogs        DocumentAccessLog[]

  @@map("documents")
}

model DocumentAccessLog {
  id           String       @id @default(uuid())
  documentId   String       @map("document_id")
  document     Document     @relation(fields: [documentId], references: [id])
  accessedById String       @map("accessed_by")
  accessedBy   User         @relation(fields: [accessedById], references: [id])
  accessedAt   DateTime     @default(now()) @map("accessed_at")
  action       AccessAction

  @@map("document_access_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  message   String
  entity    String   @db.VarChar(50)
  entityId  String?  @map("entity_id")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id")
  payload   Json?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
